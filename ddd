# ============================================================================
#  Imprime a PDF las pestañas de Edge que contienen BOMs, nombrando cada
#  archivo con el código del item extraído de la propia página.
#
#  Correcciones de esta versión:
#   - Alt+N para enfocar el campo "Nombre de archivo" del diálogo Guardar como
#     (antes el Ctrl+A no llegaba al campo y se guardaba con el nombre sugerido).
#   - {DEL} explícito para borrar el nombre previo.
#   - DevTools se cierra ANTES de abrir el diálogo de impresión.
#   - Se VERIFICA que el archivo se haya creado; si no, avisa.
#   - Sin el segundo ENTER "a ciegas": el de reemplazo solo se manda si hace falta.
#   - Esperas más holgadas en los puntos donde el diálogo tarda en responder.
# ============================================================================

Add-Type -AssemblyName System.Windows.Forms
$shell = New-Object -ComObject WScript.Shell

# ── CONFIGURACIÓN ───────────────────────────────────────────────────────────
$carpeta       = "C:\PDFs"
$totalPestanas = 50
$factorEspera  = 1.0     # súbelo a 1.5 o 2 si tu equipo va lento
# ────────────────────────────────────────────────────────────────────────────

if (!(Test-Path $carpeta)) { New-Item -ItemType Directory -Path $carpeta | Out-Null }

function Esperar($ms) { Start-Sleep -Milliseconds ([int]($ms * $factorEspera)) }
function Tecla($k)     { [System.Windows.Forms.SendKeys]::SendWait($k) }

# Extrae SOLO el código del item (p. ej. 4D-81-584Z-G)
#   /i  -> la página dice "Item:" con mayúscula
#   \S+ -> se detiene en el primer espacio (excluye la descripción)
$jsCode = 'copy((document.body.innerText.match(/item:\s*(\S+)/i)||["","sin_nombre"])[1].trim())'

function EnfocarVentana($titulo1, $titulo2) {
    $intentos = 0
    $ok = $false
    while ($intentos -lt 12 -and -not $ok) {
        Esperar 400
        $ok = $shell.AppActivate($titulo1)
        if (-not $ok -and $titulo2) { $ok = $shell.AppActivate($titulo2) }
        $intentos++
    }
    return $ok
}

$shell.AppActivate("Edge") | Out-Null
Esperar 600

# ── Desbloquear el pegado en la consola: UNA sola vez ───────────────────────
Tecla "^+j"
Esperar 1500
Set-Clipboard -Value "allow pasting"
Esperar 300
Tecla "^v"
Esperar 300
Tecla "{ENTER}"
Esperar 500
Tecla "^+j"          # cerrar DevTools
Esperar 700

$okNombre = 0; $falloNombre = 0; $okArchivo = 0; $falloArchivo = 0

for ($i = 1; $i -le $totalPestanas; $i++) {

    Write-Host ""
    Write-Host "--- Pestaña $i de $totalPestanas ---" -ForegroundColor Cyan

    # ── 1) Extraer el nombre desde la consola ───────────────────────────────
    $shell.AppActivate("Edge") | Out-Null
    Esperar 400
    Tecla "^+j"
    Esperar 1400

    Set-Clipboard -Value ""          # limpiar: no heredar el valor anterior
    Esperar 250

    Set-Clipboard -Value $jsCode
    Esperar 300
    Tecla "^v"
    Esperar 400
    Tecla "{ENTER}"
    Esperar 900

    $nombre = Get-Clipboard

    Tecla "^+j"                      # cerrar DevTools ANTES de imprimir
    Esperar 800

    # ── 2) Validar el nombre capturado ──────────────────────────────────────
    if ([string]::IsNullOrWhiteSpace($nombre) -or
        $nombre -eq $jsCode -or
        $nombre -eq "sin_nombre" -or
        $nombre.Length -gt 100) {
        Write-Host "  Nombre: NO extraido -> 'sin_nombre_$i'" -ForegroundColor Yellow
        $nombre = "sin_nombre_$i"
        $falloNombre++
    } else {
        Write-Host "  Nombre: '$nombre'" -ForegroundColor Green
        $okNombre++
    }

    $nombre = ($nombre -replace '[\\/:*?"<>|]', '_').Trim()

    # No sobrescribir si ya existe
    $destino = Join-Path $carpeta "$nombre.pdf"
    $n = 2
    while (Test-Path $destino) {
        $destino = Join-Path $carpeta "$nombre($n).pdf"
        $n++
    }

    # ── 3) Diálogo de impresión ─────────────────────────────────────────────
    Tecla "^p"
    Esperar 2000                     # la vista previa tarda

    Tecla "%s"                       # Alt+S = Guardar / Save
    Esperar 500

    # ── 4) Enfocar el diálogo "Guardar como" ────────────────────────────────
    $enfocado = EnfocarVentana "Guardar como" "Save As"
    if (-not $enfocado) {
        Write-Host "  AVISO: no se enfoco 'Guardar como'" -ForegroundColor Red
    }
    Esperar 1000                     # el diálogo tarda en aceptar teclas

    # ── 5) Reemplazar el nombre sugerido ────────────────────────────────────
    Tecla "%n"                       # Alt+N -> campo "Nombre de archivo"
    Esperar 400
    Tecla "^a"                       # seleccionar todo
    Esperar 300
    Tecla "{DEL}"                    # borrar explícitamente
    Esperar 300

    Set-Clipboard -Value $destino
    Esperar 400
    Tecla "^v"                       # pegar la ruta completa
    Esperar 500
    Tecla "{ENTER}"
    Esperar 1200

    # ── 6) Verificar que el archivo se creó ─────────────────────────────────
    $creado = $false
    for ($t = 0; $t -lt 10; $t++) {
        if (Test-Path $destino) { $creado = $true; break }
        Esperar 400
    }

    if ($creado) {
        Write-Host "  Guardado OK" -ForegroundColor Green
        $okArchivo++
    } else {
        Write-Host "  NO se encontro el archivo: $destino" -ForegroundColor Red
        $falloArchivo++
        # Puede haber quedado un diálogo abierto (p. ej. confirmar reemplazo)
        Tecla "{ENTER}"
        Esperar 800
    }

    # ── 7) Siguiente pestaña ────────────────────────────────────────────────
    $shell.AppActivate("Edge") | Out-Null
    Esperar 600
    Tecla "^{TAB}"
    Esperar 1000
}

Write-Host ""
Write-Host "===========================================" -ForegroundColor Cyan
Write-Host " Nombres extraidos OK : $okNombre"
Write-Host " Nombres fallidos     : $falloNombre"
Write-Host " Archivos guardados   : $okArchivo"
Write-Host " Archivos no creados  : $falloArchivo"
Write-Host " Carpeta: $carpeta" -ForegroundColor Cyan
Write-Host "==========================================="
