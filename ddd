# ============================================================================
#  Imprime a PDF las pestañas de Edge que contienen BOMs, nombrando cada
#  archivo con el código del item extraído de la propia página.
#
#  Cambios respecto a la versión anterior:
#   - Regex corregido: flag /i (el texto dice "Item:" con mayúscula) y \S+
#     para tomar solo el código, no toda la línea con la descripción.
#   - Se limpia el portapapeles antes de cada extracción, para no heredar
#     un valor viejo cuando copy() falla.
#   - Se muestra en pantalla lo que capturó cada iteración (antes fallaba
#     en silencio).
#   - "allow pasting" se hace UNA sola vez, fuera del bucle.
#   - DevTools se cierra con la misma combinación con que se abre.
# ============================================================================

Add-Type -AssemblyName System.Windows.Forms
$shell = New-Object -ComObject WScript.Shell

$carpeta = "C:\PDFs"
if (!(Test-Path $carpeta)) { New-Item -ItemType Directory -Path $carpeta | Out-Null }

# Cuántas pestañas procesar
$totalPestanas = 50

# Extrae SOLO el código del item (p. ej. 4D-81-584Z-G)
#   /i    -> ignora mayúsculas: la página dice "Item:", no "item:"
#   \S+   -> se detiene en el primer espacio (sin la descripción)
$jsCode = 'copy((document.body.innerText.match(/item:\s*(\S+)/i)||["","sin_nombre"])[1].trim())'

function EnfocarVentana($titulo1, $titulo2) {
    $intentos = 0
    $ok = $false
    while ($intentos -lt 10 -and -not $ok) {
        Start-Sleep -Milliseconds 400
        $ok = $shell.AppActivate($titulo1)
        if (-not $ok -and $titulo2) { $ok = $shell.AppActivate($titulo2) }
        $intentos++
    }
    return $ok
}

$shell.AppActivate("Edge") | Out-Null
Start-Sleep -Milliseconds 500

# ── Desbloquear el pegado en la consola: UNA sola vez ───────────────────────
[System.Windows.Forms.SendKeys]::SendWait("^+j")
Start-Sleep -Milliseconds 1500
Set-Clipboard -Value "allow pasting"
Start-Sleep -Milliseconds 300
[System.Windows.Forms.SendKeys]::SendWait("^v")
Start-Sleep -Milliseconds 300
[System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
Start-Sleep -Milliseconds 500
[System.Windows.Forms.SendKeys]::SendWait("^+j")   # cerrar DevTools
Start-Sleep -Milliseconds 600

$okCount = 0
$falloCount = 0

for ($i = 1; $i -le $totalPestanas; $i++) {
    Start-Sleep -Milliseconds 500

    # ── 1) Abrir consola ────────────────────────────────────────────────────
    [System.Windows.Forms.SendKeys]::SendWait("^+j")
    Start-Sleep -Milliseconds 1200

    # ── 2) Limpiar portapapeles para no heredar el valor anterior ───────────
    Set-Clipboard -Value ""
    Start-Sleep -Milliseconds 200

    # ── 3) Pegar y ejecutar el JS que extrae el código del item ─────────────
    Set-Clipboard -Value $jsCode
    Start-Sleep -Milliseconds 300
    [System.Windows.Forms.SendKeys]::SendWait("^v")
    Start-Sleep -Milliseconds 300
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
    Start-Sleep -Milliseconds 800

    $nombre = Get-Clipboard

    # Cerrar DevTools con la misma combinación con que se abrió
    [System.Windows.Forms.SendKeys]::SendWait("^+j")
    Start-Sleep -Milliseconds 600

    # ── 4) Validar lo capturado ─────────────────────────────────────────────
    if ([string]::IsNullOrWhiteSpace($nombre) -or $nombre -eq $jsCode -or $nombre -eq "sin_nombre") {
        Write-Host "[$i] NO se pudo extraer el nombre -> se usa 'sin_nombre_$i'" -ForegroundColor Yellow
        $nombre = "sin_nombre_$i"
        $falloCount++
    } else {
        Write-Host "[$i] Capturado: '$nombre'" -ForegroundColor Green
        $okCount++
    }

    # Quitar caracteres no válidos para nombre de archivo
    $nombre = $nombre -replace '[\\/:*?"<>|]', '_'
    $nombre = $nombre.Trim()

    # Evitar sobrescribir si el nombre ya existe
    $destino = Join-Path $carpeta "$nombre.pdf"
    $n = 2
    while (Test-Path $destino) {
        $destino = Join-Path $carpeta "$nombre($n).pdf"
        $n++
    }

    # ── 5) Diálogo de impresión -> Guardar como PDF ─────────────────────────
    [System.Windows.Forms.SendKeys]::SendWait("^p")
    Start-Sleep -Milliseconds 1500
    [System.Windows.Forms.SendKeys]::SendWait("%s")

    $enfocado = EnfocarVentana "Guardar como" "Save As"
    Start-Sleep -Milliseconds 500
    if (-not $enfocado) {
        Write-Host "    AVISO: no se pudo enfocar 'Guardar como' en la iteracion $i" -ForegroundColor Red
    }

    # ── 6) Escribir la ruta completa y confirmar ────────────────────────────
    Set-Clipboard -Value $destino
    Start-Sleep -Milliseconds 300
    [System.Windows.Forms.SendKeys]::SendWait("^a")
    Start-Sleep -Milliseconds 200
    [System.Windows.Forms.SendKeys]::SendWait("^v")
    Start-Sleep -Milliseconds 300
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
    Start-Sleep -Milliseconds 900
    [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")   # por si pregunta "reemplazar"
    Start-Sleep -Milliseconds 600

    # ── 7) Siguiente pestaña ────────────────────────────────────────────────
    $shell.AppActivate("Edge") | Out-Null
    Start-Sleep -Milliseconds 400
    [System.Windows.Forms.SendKeys]::SendWait("^{TAB}")
    Start-Sleep -Milliseconds 900
}

Write-Host ""
Write-Host "===========================================" -ForegroundColor Cyan
Write-Host "Terminado. Nombres extraidos OK : $okCount"
Write-Host "           Sin nombre           : $falloCount"
Write-Host "Revisa: $carpeta" -ForegroundColor Cyan
