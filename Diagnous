import fitz
from bom_layout import detect_layout
from bom_engine import find_in_bom_section, _col_bounds

PDF = r"RUTA\CE-82-064Z-B.pdf"     # el ORIGINAL de entrada
ITEM = "CE-82-016A-B"

d = fitz.open(PDF); L = detect_layout(d)
ra, rb = _col_bounds(L, "rev")
print(f"sep_page={L['sep_page']+1}  rev bounds=[{ra:.2f},{rb:.2f})")

occ = find_in_bom_section(d, L, ITEM)
print("ocurrencias:", [(o[0]+1, round(o[2],1)) for o in occ])
for pn, x0, y0, x1, y1 in occ:
    print(f"\n--- pag {pn+1}, fila y={y0:.1f} ---")
    for wx0,wy0,wx1,wy1,t,*_ in sorted(d[pn].get_text("words"), key=lambda w:w[0]):
        if abs(wy0-y0) < L["line_h"]*0.6 and 250 < wx0 < 450:
            m = "  <-- EN RANGO REV" if ra-1 <= wx0 < rb else ""
            print(f"   x={wx0:7.2f} '{t}'{m}")
